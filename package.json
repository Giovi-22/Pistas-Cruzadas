{
  "name": "pistas-cruzadas",
  "version": "0.1.0",
  "private": true,
  "main": "electron-main.js",
  "scripts": {
    "dev": "node server.js",
    "build": "next build",
    "start": "NODE_ENV=production node server.js",
    "lint": "eslint",
    "electron:dev": "concurrently \"node server.js\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.pistas.cruzadas",
    "productName": "Pistas Cruzadas",
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "files": [
      "**/*",
      "!dist/*",
      "!.next/*",
      ".next/standalone/**/*",
      ".next/static/**/*"
    ],
    "directories": {
      "output": "dist-electron"
    }
  },
  "dependencies": {
    "@ducanh2912/next-pwa": "^10.2.9",
    "cors": "^2.8.6",
    "lucide-react": "^1.7.0",
    "next": "16.2.2",
    "qrcode.react": "^4.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "electron": "^41.2.2",
    "electron-builder": "^26.8.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^9.0.5"
  }
}
